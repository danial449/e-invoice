{
  "name": "packagingbox-invoice",
  "version": "1.0.0",
  "description": "Inventory & Invoice system for Packaging Box Pakistan",
  "main": "out/main/index.js",
  "author": "Packaging Box Pakistan",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "audit": "node .audit/build.js && node .audit/audit.cjs",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "papaparse": "^5.4.1",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danial449/e-invoice.git"
  },
  "bugs": {
    "url": "https://github.com/danial449/e-invoice/issues"
  },
  "homepage": "https://github.com/danial449/e-invoice#readme"
}
